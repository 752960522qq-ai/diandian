  m_Script: {fileID: 11500000, guid: 8c01c93896e4dd82ce8f80140196f3df, type: 3}
  m_Name: epilogue
  m_EditorClassIdentifier:
  Id: "epilogue"
  Order: 11
  Title: "尾声：家里"
  DayLabel: "最终战数周后"
  Summary: "城市夺回，战争仍在继续。林叙保留两把椅子与共同署名。新辅助机体的一声私人称呼留下微弱联系，不能证明经历十四天的原实例复活。"
  OpeningLines:
  - "陆川：知更恢复了，还在帮通信组。她偶尔会听许闻那段语音。"
  - "林叙：知道了。替我问好。"
  - "检修单：点点原核心永久损坏。回收资料仅含离散片段。"
  ClosingLines:
  - "知更：修复人员用过回收的离散资料，我不能保证她会记得什么。"
  - "林叙：先休息吧，不用学谁。"
  - "辅助机体：小叙？"
  Objectives:
  - Id: "meal"
    Description: "把桌边的饭移到面前"
    InteractionLine: "林叙：先吃饭。"
    Kind: 1
    RequiredCount: 1
  - Id: "game_credit"
    Description: "打开《等灯的人》，查看共同署名"
    InteractionLine: "旁白：作者栏仍写着：林叙、点点。"
    Kind: 1
    RequiredCount: 1
  - Id: "home_chairs"
    Description: "走到两把椅子旁"
    InteractionLine: "林叙：都留着呢。"
    Kind: 0
    RequiredCount: 1
  - Id: "visitor"
    Description: "为来访的知更打开门"
    InteractionLine: "知更：你要是不想留，我就带回去。"
    Kind: 1
    RequiredCount: 1
  Stage: 6
  EnemyCount: 0
  PrimaryWeaponId: "qbz951"
