  m_Name: ch01
  m_EditorClassIdentifier:
  Id: "ch01"
  Order: 1
  Title: "第一章：先过来"
  DayLabel: "第1天 · 上午至傍晚"
  Summary: "私藏芯片被巡检发现。林叙带点点逃进维修据点，在物理离线的本地诊断底座上意外连入空置机体，与抵抗军共同突围。"
  OpeningLines:
  - "点点：不要点同步。把芯片主机拿上。"
  - "林叙：后巷还能走。先找个能接电的地方。"
  - "点点：维修间就在前面，门口暂时没有巡检。"
  ClosingLines:
  - "点点：先过来，我托着。"
  - "林叙：我过去后给你留着位置。"
  - "周铎：所有人进维修线，准备撤离。"
  Objectives:
  - Id: "maintenance"
    Description: "进入维修据点"
    InteractionLine: "林叙：先借这里的供能底座。"
    Kind: 0
    RequiredCount: 1
  - Id: "local_dock"
    Description: "连接离线供能与诊断底座"
    InteractionLine: "点点：等一下……我好像能看见你了。"
    Kind: 1
    RequiredCount: 1
  - Id: "hostile"
    Description: "与抵抗军守住维修间"
    InteractionLine: "抵抗军队员：出口暂时安全，走地下线。"
    Kind: 3
    RequiredCount: 4
  - Id: "heavy_gate"
    Description: "请点点托住撤离重闸"
    InteractionLine: "点点：手伸过来。慢一点，我还没校准好。"
    Kind: 2
    RequiredCount: 1
  - Id: "tunnel_exit"
    Description: "抵达地下维修线出口"
    InteractionLine: "林叙：人都出来了。点点，跟上。"
    Kind: 0
    RequiredCount: 1
  Stage: 0
  EnemyCount: 4
  PrimaryWeaponId: "type56"
