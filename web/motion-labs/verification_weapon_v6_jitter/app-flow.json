      "sourceSnippets": "const items=()=>state.weapon==='none'?unarmed:cfg?.weapons[state.weapon]?.type==='pistol'?pistols:['type97hawk','m870'].includes(state.weapon)?[...armed,['ShotgunPump','拉泵上膛'],...(state.weapon==='m870'?[['ShotgunAimUp','向上瞄准（适配角度）'],['ShotgunAimDown','向下瞄准（适配角度）'],['ShotgunAimLevel','水平瞄准']]:[])]:armed;\nconst duration=()=>model?.duration(state.motion,state.weapon)||0;\nfunction selectMotion(name){if(!state.ready||!items().some(m=>m[0]===name))return;const reframe=dynamicMotions.has(state.motion)||dynamicMotions.has(name);state.motion=name;state.compareRun=false;state.time=0;state.playing=true;sync();pose();if(reframe)view();}\nfunction selectWeapon(id){if(id==='winchester1897')id='m870';if(!state.ready||!(id==='none'||cfg.weapons[id]))return;state.weapon=id;showMotions();selectMotion(id==='none'?'Idle':cfg.weapons[id]?.type==='pistol'?'PistolIdle':'RifleIdle');}\n$('#play').onclick=()=>{if(state.time>=duration())state.time=0;state.playing=!state.playing;sync();};$('#speed').onchange=e=>state.speed=+e.target.value;\n$('#seek').oninput=e=>{state.playing=false;state.time=+e.target.value*duration();sync();pose();};$('#skeleton').onclick=()=>{state.skeleton=!state.skeleton;$('#skeleton').setAttribute('aria-pressed',state.skeleton);pose();};\nlet previous=performance.now();function frame(now){requestAnimationFrame(frame);const dt=Math.min((now-previous)/1000,.05);previous=now;if(state.ready&&state.playing){state.time+=dt*state.speed;const d=duration();if(state.time>=d){if(oneShots.has(state.motion)||(['type97hawk','m870'].includes(state.weapon)&&state.motion==='FiringRifle')){state.time=d;state.playing=false;sync();}else state.time%=Math.max(d,.001);}pose();}controls.update();renderer.render(scene,camera);}requestAnimationFrame(frame);"
